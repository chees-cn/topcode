{
  "name": "topcode",
  "version": "0.7.0",
  "description": "TopCode — next-generation CLI agent framework (State-Manifold paradigm)",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "author": "chees",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chees-cn/topcode.git"
  },
  "homepage": "https://github.com/chees-cn/topcode#readme",
  "bugs": "https://github.com/chees-cn/topcode/issues",
  "keywords": [
    "cli",
    "agent",
    "llm",
    "tui",
    "ai",
    "coding-assistant",
    "state-manifold"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "topcode": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "ink": "^3.2.0",
    "ink-text-input": "^4.0.3",
    "json5": "^2.2.3",
    "react": "^17.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^17.0.93",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
