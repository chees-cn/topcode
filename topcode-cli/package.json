{
  "name": "topcode-cli",
  "version": "0.4.0",
  "description": "TopCode — next-generation CLI agent framework (State-Manifold paradigm)",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "topcode": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "node --import tsx --test \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "json5": "^2.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
